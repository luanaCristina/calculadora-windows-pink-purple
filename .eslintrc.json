{
    "env": {
        "browser": true,
        "es2021": true,
        "jest": true,
        "cypress/globals": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "semi": ["error", "always"],
        "quotes": ["warn", "single"]
    }
}
