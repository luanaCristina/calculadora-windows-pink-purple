# ============================================
# VARIÁVEIS DE AMBIENTE - Template
# Copie este arquivo e renomeie para .env.local, .env.staging ou .env.production
# NUNCA faça commit dos arquivos .env reais!
# ============================================

# Ambiente (development | staging | production)
APP_ENV=development

# URL base da aplicação
APP_URL=http://localhost:3000

# Porta do servidor
APP_PORT=3000

# Ativar logs de debug
DEBUG=true

# API Key (exemplo - não é usado na calculadora)
API_KEY=your-api-key-here

# Analytics ID
ANALYTICS_ID=UA-XXXXXXXX-X
