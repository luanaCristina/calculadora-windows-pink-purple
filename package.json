{
  "name": "calculadora-windows-pink-purple",
  "version": "1.0.0",
  "description": "🧮 Calculadora estilo Windows com paleta Pink, Purple & White",
  "main": "script.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "cypress run --headless",
    "test:e2e:open": "cypress open",
    "lint": "eslint . --ext .js",
    "serve": "npx http-server . -p 3000 -c-1",
    "ci": "npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "cypress": "^13.13.0",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "script.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "keywords": ["calculator", "windows", "pink", "purple", "html", "css", "javascript"],
  "author": "Luana Crystinne",
  "license": "MIT"
}
